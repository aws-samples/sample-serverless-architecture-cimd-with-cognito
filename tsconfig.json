{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "lib": ["es2022"],
    "strict": true, "noImplicitReturns": true, "noUnusedLocals": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "types": ["node", "jest"]
  },
  "include": ["bin", "lib", "tests/cdk", "config.ts"],
  "exclude": ["node_modules", "cdk.out", "spike"]
}
